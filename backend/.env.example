# Backend settings. Copy this file to .env and adjust the values.
# Never commit .env: it holds real secrets.

# "development" writes verification codes to the server log when email is off.
ENVIRONMENT=development

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALG=HS256
# Token lifetime in minutes (1440 = 24 hours)
JWT_EXPIRES_MIN=1440

# SQLite needs no setup and is fine for local development.
# Production uses PostgreSQL, e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./subsaver.db

# Comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# Base URL of the frontend, used for links in emails
FRONTEND_URL=http://localhost:3000

# Outgoing email. Leave SMTP_HOST empty to send nothing (codes then appear in the log in development).
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@subsaver.example
SMTP_FROM_NAME=SubSaver

# Secret shared with the frontend proxy. When set, the API answers 403 to requests
# that did not come through the site. Leave empty for local development.
PROXY_SHARED_SECRET=

# Reverse proxies in front of the API; used to find the client IP for rate limits
# when PROXY_SHARED_SECRET is not set. 0 = ignore X-Forwarded-For.
TRUSTED_PROXY_COUNT=0

# Temporary per-visitor demo accounts with sample data, deleted after 24 hours.
DEMO_ENABLED=true
