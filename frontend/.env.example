# Frontend settings. Copy this file to .env.local and adjust the values.

# Backend URL the /backend_api route handler forwards requests to
BACKEND_URL=http://localhost:8000

# Secret shared with the backend (server-only). Leave empty for local development.
PROXY_SHARED_SECRET=

# "true" shows the "Try the demo" button (the backend needs DEMO_ENABLED=true)
NEXT_PUBLIC_DEMO_ENABLED=true

# Optional: public site URL for link previews, and a contact address
# (contact links are hidden when it is empty)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
